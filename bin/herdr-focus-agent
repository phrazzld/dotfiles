#!/usr/bin/env bash
# Raise the Herdr terminal in Hyprland and select the target workspace/tab.
set -euo pipefail

resolve_window_address() {
  command -v hyprctl >/dev/null 2>&1 || return 0

  local clients_json
  clients_json=$(hyprctl clients -j 2>/dev/null || true)
  [[ -n $clients_json ]] || return 0

  local candidate_pids=()
  while read -r pid; do
    [[ -n $pid ]] || continue
    local cmd
    cmd=$(tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null || true)
    if [[ $cmd != *"herdr server"* ]]; then
      candidate_pids+=("$pid")
    fi
  done < <(pgrep -x herdr 2>/dev/null || true)

  ((${#candidate_pids[@]} > 0)) || return 0

  local matched_addresses=()
  for pid in "${candidate_pids[@]}"; do
    local cur=$pid
    while [[ $cur -gt 1 ]]; do
      local addr
      addr=$(jq -r --argjson p "$cur" '.[] | select(.pid == $p) | .address // empty' <<<"$clients_json")
      if [[ -n $addr ]]; then
        matched_addresses+=("$addr")
        break
      fi
      cur=$(ps -o ppid= -p "$cur" 2>/dev/null | tr -d ' ' || true)
      [[ -n $cur ]] || break
    done
  done

  local unique_addresses=()
  if ((${#matched_addresses[@]} > 0)); then
    mapfile -t unique_addresses < <(printf '%s\n' "${matched_addresses[@]}" | sort -u)
  fi

  if ((${#unique_addresses[@]} == 1)); then
    echo "${unique_addresses[0]}"
  fi
}

resolve_space() {
  local target=$1 json ws tab

  json=$(herdr pane get "$target" 2>/dev/null || true)
  ws=$(jq -r '.result.pane.workspace_id // empty' <<<"$json" 2>/dev/null || true)
  tab=$(jq -r '.result.pane.tab_id // empty' <<<"$json" 2>/dev/null || true)
  if [[ -n $ws && -n $tab ]]; then
    printf '%s %s\n' "$ws" "$tab"
    return 0
  fi

  json=$(herdr agent get "$target" 2>/dev/null || true)
  ws=$(jq -r '.result.agent.workspace_id // empty' <<<"$json" 2>/dev/null || true)
  tab=$(jq -r '.result.agent.tab_id // empty' <<<"$json" 2>/dev/null || true)
  if [[ -n $ws && -n $tab ]]; then
    printf '%s %s\n' "$ws" "$tab"
    return 0
  fi

  return 1
}

if [[ ${1:-} == "--resolve-address" ]]; then
  resolve_window_address
  exit 0
fi

target="${1:-}"

# 1. Select the Herdr space. agent.focus does not switch workspace/tab from a
#    detached click; workspace.focus + tab.focus are the UI selection commands.
if [[ -n $target ]] && command -v herdr >/dev/null 2>&1; then
  if space=$(resolve_space "$target"); then
    read -r workspace_id tab_id <<<"$space"
    herdr workspace focus "$workspace_id" >/dev/null 2>&1 || true
    herdr tab focus "$tab_id" >/dev/null 2>&1 || true
  fi
fi

# 2. Raise the host terminal window in Hyprland
addr=$(resolve_window_address)
if [[ -n $addr ]]; then
  hyprctl dispatch "hl.dsp.focus({ window = \"address:$addr\" })" >/dev/null 2>&1 || \
    hyprctl dispatch focuswindow "address:$addr" >/dev/null 2>&1
fi
